# InfraMP configuration
# Copy to .env and adjust. All values are read with the INFRAMP_ prefix.

# Name shown in the UI.
INFRAMP_APP_NAME=InfraMP

# Directory where the SQLite database is stored (relative to CWD or absolute).
INFRAMP_DATA_DIR=./data

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INFRAMP_SECRET_KEY=change-me-to-a-long-random-string

# Session cookie name and lifetime.
INFRAMP_SESSION_COOKIE_NAME=infra_mp_session
INFRAMP_SESSION_TTL_DAYS=7

# Initial admin account, seeded on first startup when the users table is empty.
# If INFRAMP_ADMIN_PASSWORD is left empty, a random password is generated and
# printed to stdout once during startup.
INFRAMP_ADMIN_USERNAME=admin
INFRAMP_ADMIN_PASSWORD=
INFRAMP_ADMIN_DISPLAY_NAME=Administrator

# Enable FastAPI debug mode (NOT for production).
INFRAMP_DEBUG=false

# Enable the embedded MCP server at /mcp (agents access with API tokens
# generated in the UI). Set to false to disable it entirely.
INFRAMP_MCP_ENABLED=true

# Public base URL of this instance, advertised in the MCP authentication
# metadata. Set to the externally reachable URL (e.g. https://inframp.example.com)
# when clients connect from other machines.
INFRAMP_BASE_URL=http://localhost:8000
