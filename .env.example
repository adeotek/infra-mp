# HomeLab Manager configuration
# Copy to .env and adjust. All values are read with the HOMELAB_ prefix.

# Directory where the SQLite database is stored (relative to CWD or absolute).
HOMELAB_DATA_DIR=./data

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HOMELAB_SECRET_KEY=change-me-to-a-long-random-string

# Session cookie name and lifetime.
HOMELAB_SESSION_COOKIE_NAME=homelab_session
HOMELAB_SESSION_TTL_DAYS=7

# Initial admin account, seeded on first startup when the users table is empty.
# If HOMELAB_ADMIN_PASSWORD is left empty, a random password is generated and
# printed to stdout once during startup.
HOMELAB_ADMIN_USERNAME=admin
HOMELAB_ADMIN_PASSWORD=
HOMELAB_ADMIN_DISPLAY_NAME=Administrator

# Enable FastAPI debug mode (NOT for production).
HOMELAB_DEBUG=false
